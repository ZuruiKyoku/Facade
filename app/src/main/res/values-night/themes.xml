<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Facade" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="colorPrimary">@color/facade_dark_primary</item>
        <item name="colorOnPrimary">@color/facade_dark_onPrimary</item>
        <item name="android:colorBackground">@color/facade_dark_background</item>
    </style>

    <style name="Theme.Facade.Launcher" parent="Theme.Facade">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
